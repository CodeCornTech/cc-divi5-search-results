{
  "name": "codecorn/search-results",
  "d4Shortcode": "",
  "title": "CC Search Results",
  "titles": "CC Search Results",
  "moduleIcon": "divi/module-search",
  "moduleClassName": "cc-d5sr",
  "moduleOrderClassName": "cc-d5sr",
  "childModuleName": "codecorn/search-result-type",
  "childModuleTitle": "CC Result Type",
  "category": "module",
  "childrenName": [
    "codecorn/search-result-type"
  ],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "CC Search Results"
            }
          }
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "htmlAttributes": {},
          "link": {},
          "text": {}
        },
        "decoration": {
          "animation": {},
          "background": {},
          "border": {},
          "boxShadow": {},
          "disabledOn": {},
          "filters": {},
          "overflow": {},
          "position": {},
          "scroll": {},
          "sizing": {},
          "spacing": {},
          "sticky": {},
          "transform": {},
          "transition": {},
          "zIndex": {}
        }
      }
    },
    "query": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "source": "current",
              "searchTerm": "",
              "postsPerPage": "10"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "source": {
              "groupSlug": "contentQuery",
              "priority": 10,
              "render": true,
              "subName": "source",
              "label": "Query source",
              "features": {
                "sticky": false,
                "responsive": false,
                "hover": false,
                "dynamicContent": false
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "current": {
                      "label": "Current search query"
                    },
                    "isolated": {
                      "label": "Isolated query"
                    }
                  }
                }
              }
            },
            "searchTerm": {
              "groupSlug": "contentQuery",
              "priority": 20,
              "render": true,
              "subName": "searchTerm",
              "label": "Search term",
              "description": "Used by the isolated query and Visual Builder previews.",
              "features": {
                "sticky": false,
                "responsive": false,
                "hover": false,
                "dynamicContent": false
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "postsPerPage": {
              "groupSlug": "contentQuery",
              "priority": 30,
              "render": true,
              "subName": "postsPerPage",
              "label": "Results per page",
              "features": {
                "sticky": false,
                "responsive": false,
                "hover": false,
                "dynamicContent": false
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          }
        }
      }
    },
    "display": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "showSummary": "on",
              "showSearchForm": "on",
              "preset": "grid",
              "columns": "3",
              "ajaxPagination": "on"
            }
          },
          "tablet": {
            "value": {
              "columns": "2"
            }
          },
          "phone": {
            "value": {
              "columns": "1"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "showSummary": {
              "groupSlug": "contentDisplay",
              "priority": 10,
              "render": true,
              "subName": "showSummary",
              "label": "Show result count",
              "features": {
                "sticky": false,
                "responsive": false,
                "hover": false,
                "dynamicContent": false
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            },
            "showSearchForm": {
              "groupSlug": "contentDisplay",
              "priority": 20,
              "render": true,
              "subName": "showSearchForm",
              "label": "Show search form above results",
              "features": {
                "sticky": false,
                "responsive": false,
                "hover": false,
                "dynamicContent": false
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            },
            "preset": {
              "groupSlug": "contentDisplay",
              "priority": 30,
              "render": true,
              "subName": "preset",
              "label": "Output preset",
              "features": {
                "sticky": false,
                "responsive": false,
                "hover": false,
                "dynamicContent": false
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "grid": {
                      "label": "Editorial grid"
                    },
                    "compact-list": {
                      "label": "Compact vertical list"
                    },
                    "classic-card": {
                      "label": "Classic image card"
                    }
                  }
                }
              }
            },
            "columns": {
              "groupSlug": "contentDisplay",
              "priority": 40,
              "render": true,
              "subName": "columns",
              "label": "Columns",
              "description": "Responsive column count for grid and classic-card presets.",
              "features": {
                "sticky": false,
                "responsive": true,
                "hover": false,
                "dynamicContent": false
              },
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "1": {
                      "label": "1"
                    },
                    "2": {
                      "label": "2"
                    },
                    "3": {
                      "label": "3"
                    },
                    "4": {
                      "label": "4"
                    },
                    "5": {
                      "label": "5"
                    },
                    "6": {
                      "label": "6"
                    }
                  }
                }
              }
            },
            "ajaxPagination": {
              "groupSlug": "contentDisplay",
              "priority": 50,
              "render": true,
              "subName": "ajaxPagination",
              "label": "AJAX pagination",
              "description": "Loads the next result page without a full-page refresh and falls back to normal links on failure.",
              "features": {
                "sticky": false,
                "responsive": false,
                "hover": false,
                "dynamicContent": false
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          }
        }
      }
    },
    "emptyState": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "title": "Nessun risultato trovato",
              "body": "Prova con un termine diverso oppure visita un’altra sezione del sito."
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "title": {
              "groupSlug": "contentEmpty",
              "priority": 10,
              "render": true,
              "subName": "title",
              "label": "Empty-state title",
              "features": {
                "sticky": false,
                "responsive": false,
                "hover": false,
                "dynamicContent": false
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            },
            "body": {
              "groupSlug": "contentEmpty",
              "priority": 20,
              "render": true,
              "subName": "body",
              "label": "Empty-state message",
              "features": {
                "sticky": false,
                "responsive": false,
                "hover": false,
                "dynamicContent": false
              },
              "component": {
                "type": "field",
                "name": "divi/textarea"
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "summary": {
      "subName": "summary",
      "label": "Result summary",
      "selectorSuffix": " .cc-d5sr__summary"
    },
    "searchForm": {
      "subName": "searchForm",
      "label": "Search form",
      "selectorSuffix": " .cc-d5sr__search"
    },
    "results": {
      "subName": "results",
      "label": "Results wrapper",
      "selectorSuffix": " .cc-d5sr__results"
    },
    "card": {
      "subName": "card",
      "label": "Result card",
      "selectorSuffix": " .cc-d5sr__card"
    },
    "cardImage": {
      "subName": "cardImage",
      "label": "Card image",
      "selectorSuffix": " .cc-d5sr__image"
    },
    "cardTitle": {
      "subName": "cardTitle",
      "label": "Card title",
      "selectorSuffix": " .cc-d5sr__title"
    },
    "pagination": {
      "subName": "pagination",
      "label": "Pagination",
      "selectorSuffix": " .cc-d5sr__pagination"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentQuery": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentQuery",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Query"
          }
        }
      },
      "contentDisplay": {
        "panel": "content",
        "priority": 20,
        "groupName": "contentDisplay",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Layout and navigation"
          }
        }
      },
      "contentEmpty": {
        "panel": "content",
        "priority": 30,
        "groupName": "contentEmpty",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Empty state"
          }
        }
      }
    }
  }
}
